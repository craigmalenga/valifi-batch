  "info": {
    "_postman_id": "c7b805e7-8d3c-432d-b5da-4723916fa8bb",
    "name": "Valifi Client Postman Collection",
    "description": "Welcome to the **Valifi Platform Postman Collection**! This collection streamlines your integration with the Valifi Platform, providing easy access to our suite of APIs. With this collection, you can perform these key actions:\n\n1. **Authentication:** Securely access our APIs by authenticating your application through our pre-configured authentication flow for managing access tokens.\n    \n2. **OTP**: Verify that customers have possession of their stated mobile number.\n    \n3. **AML + Mobile ID:** Generate an AML Report before requesting a credit report, with optional mobile verification against bureau data.\n    \n4. **Requesting KBA Questions:** Access Knowledge-Based Authentication (KBA) questions for identity verification. These real-time questions provide robust and compliant verification.\n    \n5. **Requesting Equifax CZ Credit Reports:** Access comprehensive credit reports through our Equifax (CZ) API for financial assessments and claims management.\n    \n6. **Requesting TransUnion Credit Reports:** Access comprehensive credit reports through our TransUnion API for financial assessments and claims management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
    "_exporter_id": "27621989",
    "_collection_link": ""
  },
